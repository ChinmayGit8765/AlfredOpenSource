# Copy to .env (gitignored) or export in your shell before `alfred run`.
# NEVER commit the real tokens: each grants control of a channel into ALFRED.

# Discord bot token. Create a bot at
# https://discord.com/developers/applications
ALFRED_DISCORD_TOKEN=

# Telegram bot token from @BotFather. Only needed when telegram.enabled is
# true in config/alfred.yaml.
ALFRED_TELEGRAM_TOKEN=

# Bearer token for the local HTTP API. Only needed when http.enabled is true;
# the API refuses to start without it. Use a long random value.
ALFRED_HTTP_TOKEN=

# API key for the model backend when llm.provider is "openai" (any
# OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, LM Studio, vLLM...).
# Leave empty for keyless private endpoints. Unused when llm.provider is
# "ollama" (the default).
ALFRED_LLM_API_KEY=
